       IDENTIFICATION DIVISION.
       PROGRAM-ID. TRANS-PROC.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCOUNTS-FILE ASSIGN TO "ACCOUNTS.DAT".
           SELECT TEMP-FILE     ASSIGN TO "ACCOUNTS.TMP".
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY "ACCOUNTS.CPY".
       01  WS-WITHDRAW-AMOUNT   PIC 9(7)V99 VALUE 0.
       01  WS-DEPOSIT-AMOUNT    PIC 9(7)V99 VALUE 0.
       01  WS-TRAN-TYPE         PIC X(1).

       PROCEDURE DIVISION.
       0000-PROCESS-TRANSACTION.
           PERFORM 1000-CHECK-STATUS.
           PERFORM 2000-HANDLE-WITHDRAWAL.
           STOP RUN.

       1000-CHECK-STATUS.
           IF ACC-STATUS = 'S'
               DISPLAY "Account Suspended."
           END-IF.

       2000-HANDLE-WITHDRAWAL.
           IF ACC-BALANCE < WS-WITHDRAW-AMOUNT
               DISPLAY "No Funds."
           ELSE
               SUBTRACT WS-WITHDRAW-AMOUNT FROM ACC-BALANCE
           END-IF.
